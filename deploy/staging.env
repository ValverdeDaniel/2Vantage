# Staging's configuration (slice 69; deploy/README.md). Names only: no secret is ever written here. Secrets live in
# Secret Manager, and the *_VERSION lines pin which version each service reads (never `latest`, plan.md §11.2).
# deploy/render.py fills deploy/cloudrun/*.yaml from this file and refuses to render while a value is blank.
# Connecting staging is filling in the blanks below, then following deploy/README.md.

# ---- The project (README step 1). Region: us-east1, as the old app's deployment plan decided (cost, Cloud SQL). ----
PROJECT_ID=
PROJECT_NUMBER=
REGION=us-east1

# ---- Images: <REGION>-docker.pkg.dev/<PROJECT_ID>/<REPOSITORY>/<IMAGE_NAME>:<full commit SHA> --------------------
REPOSITORY=vantage
IMAGE_NAME=app

# ---- Cloud Run: two services and two jobs, one runtime service account ---------------------------------------
WEB_SERVICE=vantage-web
WORKER_SERVICE=vantage-worker
MIGRATE_JOB=vantage-migrate
MANAGE_JOB=vantage-manage
RUN_SERVICE_ACCOUNT=vantage-run
# The web service's own address: https://<WEB_SERVICE>-<PROJECT_NUMBER>.<REGION>.run.app (Cloud Run's stable URL).
WEB_HOST=
# Direct VPC egress to the database's private IP (§11.2: private connectivity).
VPC_NETWORK=default
VPC_SUBNET=default

# ---- Cloud SQL for PostgreSQL 15 (the local major, pinned), private IP only ------------------------------------
SQL_INSTANCE=vantage-db
SQL_TIER=db-g1-small
DB_NAME=vantage2
DB_USER=vantage
# The instance's private IP (README step 4: gcloud sql instances describe … --format='value(ipAddresses[0].ipAddress)').
DB_PRIVATE_IP=

# ---- Files: the private bucket ----------------------------------------------------------------------------------
BUCKET=

# ---- Mail: vantage.E003 refuses the console backend in production. Which mailbox sends is open (report, OQ) ----
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=

# ---- The agency --------------------------------------------------------------------------------------------------
AGENCY_TIME_ZONE=America/New_York

# ---- Microsoft 365 sign-in and the PHI gate (slice 47; deploy/phi-gate.md) ----------------------------------------
# The firm's Entra ID app registration (README step 5b): its directory (tenant) id and application (client) id.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# true until the gate; then false, so only Microsoft 365 signs people in (MFA and offboarding live there).
AUTH_PASSWORD_SIGNIN=true
# false until the gate's last step; vantage.E006 refuses true while passwords are on or Microsoft 365 is off.
AI_PHI_READERS=false

# ---- Secret Manager: the secret names, and the version each service reads ---------------------------------------
SECRET_DJANGO_KEY=vantage-django-secret-key
SECRET_DJANGO_KEY_VERSION=1
SECRET_DB_PASSWORD=vantage-db-password
SECRET_DB_PASSWORD_VERSION=1
SECRET_DB_CA=vantage-db-server-ca
SECRET_DB_CA_VERSION=1
SECRET_EMAIL_PASSWORD=vantage-email-password
SECRET_EMAIL_PASSWORD_VERSION=1
SECRET_FIRST_ADMIN_PASSWORD=vantage-first-admin-password
SECRET_FIRST_ADMIN_PASSWORD_VERSION=1
SECRET_ENTRA_CLIENT=vantage-entra-client-secret
SECRET_ENTRA_CLIENT_VERSION=1
