# Local dev server (plan.md §3.4). node_modules lives in the image and an anonymous volume, never on the host.
FROM node:22-alpine
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=node:node . .
EXPOSE 4001
CMD ["npm", "run", "dev"]
