# Copy to .env to override the docker-compose defaults. Safe local values only; no secrets.
DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=True
ENVIRONMENT=local
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=vantage2
DB_USER=vantage
DB_PASSWORD=vantage-dev
DB_HOST=db
DB_PORT=5432
FRONTEND_URL=http://localhost:4001
MEDIA_ROOT=/data/media
AGENCY_TIME_ZONE=America/New_York
SESSION_COOKIE_AGE=43200
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
GIT_SHA=unknown
# Staging and production only (slice 69; deploy/README.md). Empty locally: files stay under MEDIA_ROOT, Postgres on db.
GS_BUCKET_NAME=
CLOUD_SQL_INSTANCE=
DB_SSLMODE=
DB_SSLROOTCERT=
# Claude (slice 18; plan.md §3.5). Empty key: no Claude. Defaults: Sonnet 5.5, reads at high effort, $3 a run, $25 a
# deal. AI_TOTAL_BUDGET_USD caps the sum of every call this database has recorded (`manage.py ai_spend` shows it);
# leave it empty in production (no cap).
ANTHROPIC_API_KEY=
AI_MODEL=
AI_EFFORT_READ=
AI_EFFORT_RECHECK=
AI_EFFORT_TURN=
AI_READ_LIMIT_USD=
AI_DEAL_BUDGET_USD=
AI_TOTAL_BUDGET_USD=
# The PHI gate (slice 47; plan.md §11.4; deploy/phi-gate.md). Microsoft 365 sign-in is on once the firm's Entra app
# registration is named (its directory id, client id and secret); its redirect URI is FRONTEND_URL +
# /api/auth/microsoft/callback/. AUTH_PASSWORD_SIGNIN=false turns username and password off (the gate does, so MFA
# and offboarding live in Microsoft 365). AI_PHI_READERS turns the census, intake and questionnaire readers on: last.
AUTH_OIDC_TENANT_ID=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_PASSWORD_SIGNIN=true
AI_PHI_READERS=false
