# VCS
.git
.gitignore

# Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example

# Runtime data the container creates itself
media/
staticfiles/

# The frontend is its own image locally (Dockerfile.dev); the production image's `spa` stage builds it (slice 69,
# §11.2) from its sources, with its own npm ci, and drops them from the app.
frontend/node_modules/
frontend/dist/
frontend/.vite/

# The parity and browser harnesses run beside the app, never in its image (§3.4)
browser/
tools/

# Docs and specs (README.md ships). `*.md` matches the root's only, so docs/ is named (slice 69).
docs/
*.md
!README.md
**/CLAUDE.md

# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# OS
.DS_Store
Thumbs.db
